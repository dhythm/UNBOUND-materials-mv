{
  "name": "unbound-motion",
  "version": "1.0.0",
  "private": true,
  "description": "UNBOUND — 75s kinetic typography (Remotion)",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "render:proto": "remotion render Prototype out/unbound-prototype.mp4 --codec=h264 --crf=16 --gl=angle",
    "render:main": "remotion render Unbound out/unbound-75s.mp4 --codec=h264 --crf=16 --gl=angle"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/three": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532",
    "svg-path-properties": "2.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
